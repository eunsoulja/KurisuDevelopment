# Bot token from the Discord Developer Portal -> Bot. Never commit the real value.
DISCORD_TOKEN=
# Application (client) ID
CLIENT_ID=
# Optional: register commands to one guild instantly (testing). Leave empty for global.
DEV_GUILD_ID=
# Comma-separated Discord user IDs of the bot owner(s). Always exempt from antinuke, can edit the whitelist.
OWNER_IDS=
# SQLite file location
DATABASE_PATH=./data/kurisu.db
# true = register slash commands automatically on startup
AUTO_DEPLOY=false
# debug | info | warn | error
LOG_LEVEL=info
