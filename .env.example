# Bot token from the Discord Developer Portal -> Bot. Never commit the real value.
DISCORD_TOKEN=
# Application (client) ID
CLIENT_ID=
# Optional: register commands to one guild instantly (testing). Leave empty for global.
DEV_GUILD_ID=
# Comma-separated Discord user IDs of the bot owner(s). Always exempt from antinuke,
# can edit the whitelist, and are the only users allowed to run /guilds.
OWNER_IDS=
# MongoDB Atlas connection string (placeholder only). Use the real URI in .env only; never commit it.
# The database name defaults to "prismo" when present in the URI; override with DATABASE_NAME if needed.
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# Optional: MongoDB database name override (defaults to the URI database name, or "prismo")
DATABASE_NAME=
# SQLite file location used only by scripts/migrate-sqlite-to-mongo.js during one-time migration
DATABASE_PATH=./data/kurisu.db
# true = register slash commands automatically on startup
AUTO_DEPLOY=false
# debug | info | warn | error
LOG_LEVEL=info
